# Copy this file to .env. .env is in .gitignore and is never committed.
# Pairing code the SatarkPay phone app must send. ./run.sh wifi creates one if it is missing.
SATARK_TOKEN=
# Logins: salted hashes only. ./run.sh creates them and prints the passwords once.
SATARK_PASS_USER=
SATARK_PASS_MERCHANT=
SATARK_PASS_ADMIN=
# Optional inbox watcher, on a laptop only. A Gmail app password, not the normal password. Use a test mailbox.
IMAP_USER=
IMAP_PASSWORD=
